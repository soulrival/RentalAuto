{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=rental_db;Username=postgres;Password=**********;Persist Security Info=True"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Authentication": {
    "Cookie": {
      "Name": "RentalAppAuth"
    }
  },
  "Security": {
    "PasswordRequirements": {
      "RequireDigit": true,
      "RequireLowercase": true,
      "RequireNonAlphanumeric": true,
      "RequireUppercase": true,
      "RequiredLength": 8
    }
  }
}
