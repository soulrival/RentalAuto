@page "{sortOrder?}/{searchString?}/{pageIndex?}"
@model RentalAuto.Pages.Inspectors.IndexModel
@{
    ViewData["Title"] = "Список осмотрщиков";
}

<h1>Список осмотрщиков</h1>

<p>
    <a asp-page="Create" class="btn btn-primary">Добавить нового осмотрщика</a>
</p>

@* Форма поиска *@
<form asp-page="./Index" method="get">
    <div class="form-actions no-color">
        <p>
            Найти по ФИО:
            <input type="text" name="SearchString" value="@Model.CurrentFilter" class="form-control d-inline" style="width: 200px;" />
            <input type="submit" value="Поиск" class="btn btn-sm btn-outline-secondary" /> |
            <a asp-page="./Index">Показать все</a>
        </p>
    </div>
</form>

<table class="table table-hover">
    <thead class="table-light">
        <tr>
            <th>
                <a asp-page="./Index" 
                   asp-route-sortOrder="@(Model.CurrentSort == "surname_asc" ? "surname_desc" : "surname_asc")"
                   asp-route-searchString="@Model.CurrentFilter">
                    Фамилия @if (Model.CurrentSort == "surname_asc") { <span>▲</span> } else if (Model.CurrentSort == "surname_desc") { <span>▼</span> }
                </a>
            </th>
            <th>
                <a asp-page="./Index" 
                   asp-route-sortOrder="@(Model.CurrentSort == "name_asc" ? "name_desc" : "name_asc")"
                   asp-route-searchString="@Model.CurrentFilter">
                    Имя @if (Model.CurrentSort == "name_asc") { <span>▲</span> } else if (Model.CurrentSort == "name_desc") { <span>▼</span> }
                </a>
            </th>
            <th>
                <a asp-page="./Index" 
                   asp-route-sortOrder="@(Model.CurrentSort == "hiredate_asc" ? "hiredate_desc" : "hiredate_asc")"
                   asp-route-searchString="@Model.CurrentFilter">
                    Дата приема @if (Model.CurrentSort == "hiredate_asc") { <span>▲</span> } else if (Model.CurrentSort == "hiredate_desc") { <span>▼</span> }
                </a>
            </th>
            <th>Действия</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Inspector) {
        <tr>
            <td>@Html.DisplayFor(modelItem => item.Surname)</td>
            <td>@Html.DisplayFor(modelItem => item.Firstname)</td>
            <td>@Html.DisplayFor(modelItem => item.HireDate)</td>
            <td>
                <a asp-page="./Details" asp-route-id="@item.InspectorId" class="btn btn-sm btn-info">Подробнее</a>
                <a asp-page="./Edit" asp-route-id="@item.InspectorId" class="btn btn-sm btn-warning">Редактировать</a>
                <a asp-page="./Delete" asp-route-id="@item.InspectorId" class="btn btn-sm btn-danger">Удалить</a>
            </td>
        </tr>
}
    </tbody>
</table>

@* Пагинация *@
<nav>
    <ul class="pagination">
        <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
            <a class="page-link" asp-page="./Index" 
               asp-route-sortOrder="@Model.CurrentSort"
               asp-route-searchString="@Model.CurrentFilter"
               asp-route-pageIndex="@(Model.CurrentPage - 1)">Предыдущая</a>
        </li>
        
        @for (int i = 1; i <= Model.TotalPages; i++)
        {
            <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                <a class="page-link" asp-page="./Index"
                   asp-route-sortOrder="@Model.CurrentSort"
                   asp-route-searchString="@Model.CurrentFilter"
                   asp-route-pageIndex="@i">@i</a>
            </li>
        }
        
        <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
            <a class="page-link" asp-page="./Index" 
               asp-route-sortOrder="@Model.CurrentSort"
               asp-route-searchString="@Model.CurrentFilter"
               asp-route-pageIndex="@(Model.CurrentPage + 1)">Следующая</a>
        </li>
    </ul>
</nav>