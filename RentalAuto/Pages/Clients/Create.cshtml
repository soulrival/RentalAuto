@page
@model RentalAuto.Pages.Bookings.CreateModel
@{
    ViewData["Title"] = "Создать бронирование";
}

<h1>Создать новое бронирование</h1>
<hr />
<div class="row">
    <div class="col-md-8">
        <form method="post">
            <div asp-validation-summary="All" class="text-danger"></div>
            
            <div class="row mb-3">
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="control-label">Автомобиль</label>
                        <select asp-for="Booking.CarId" class="form-control" required>
                            <option value="">-- Выберите автомобиль --</option>
                            @foreach (var car in Model.CarList)
                            {
                                <option value="@car.Value">@car.Text</option>
                            }
                        </select>
                        <span asp-validation-for="Booking.CarId" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="control-label">Локация получения</label>
                        <select asp-for="Booking.PickupLocationId" class="form-control" required>
                            <option value="">-- Выберите локацию --</option>
                            @foreach (var location in Model.LocationList)
                            {
                                <option value="@location.Value">@location.Text</option>
                            }
                        </select>
                        <span asp-validation-for="Booking.PickupLocationId" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="control-label">Локация возврата</label>
                        <select asp-for="Booking.ReturnLocationId" class="form-control" required>
                            <option value="">-- Выберите локацию --</option>
                            @foreach (var location in Model.LocationList)
                            {
                                <option value="@location.Value">@location.Text</option>
                            }
                        </select>
                        <span asp-validation-for="Booking.ReturnLocationId" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="StartDate" class="control-label"></label>
                        <input asp-for="StartDate" class="form-control" type="date" required />
                        <span asp-validation-for="StartDate" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="EndDate" class="control-label"></label>
                        <input asp-for="EndDate" class="form-control" type="date" required />
                        <span asp-validation-for="EndDate" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="form-group mb-3">
                <label class="control-label">Дополнительные услуги</label>
                <div class="row">
                    @if (Model.ServiceList != null && Model.ServiceList.Any())
                    {
                        @foreach (var service in Model.ServiceList)
                        {
                            <div class="col-md-4 mb-2">
                                <div class="form-check">
                                    <input type="checkbox" 
                                           name="SelectedServiceIds" 
                                           value="@service.Value" 
                                           class="form-check-input" 
                                           id="service_@service.Value" />
                                    <label class="form-check-label" for="service_@service.Value">
                                        @service.Text
                                    </label>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="col-12">
                            <p class="text-muted">Нет доступных дополнительных услуг</p>
                        </div>
                    }
                </div>
            </div>

            <div class="form-group mt-3">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-cart-plus me-1"></i>Создать бронирование
                </button>
                <a asp-page="./Index" class="btn btn-secondary">
                    <i class="bi bi-arrow-left me-1"></i>Отмена
                </a>
            </div>
        </form>
    </div>
    <div class="col-md-4">
        <div class="card border-info">
            <div class="card-header bg-info text-white">
                <h5 class="card-title mb-0">
                    <i class="bi bi-info-circle me-1"></i>Информация о бронировании
                </h5>
            </div>
            <div class="card-body">
                <p class="card-text">
                    <strong>Важно:</strong>
                </p>
                <ul class="card-text">
                    <li>Бронирование возможно только для доступных автомобилей</li>
                    <li>Стоимость рассчитывается автоматически с учетом всех услуг</li>
                    <li>После бронирования автомобиль становится недоступным для других клиентов</li>
                    <li>Выбранные даты не должны пересекаться с существующими бронированиями</li>
                </ul>
                <div class="alert alert-warning mt-3">
                    <i class="bi bi-exclamation-triangle me-1"></i>
                    <strong>Внимание:</strong> Отмена бронирования возможна только через администратора.
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const startDateInput = document.querySelector('[asp-for="StartDate"]');
            const endDateInput = document.querySelector('[asp-for="EndDate"]');
            
            if (startDateInput && endDateInput) {
                // Установка минимальных дат
                const today = new Date();
                today.setHours(0, 0, 0, 0);
                const todayStr = today.toISOString().split('T')[0];
                
                startDateInput.min = todayStr;
                startDateInput.value = todayStr;
                
                const tomorrow = new Date(today);
                tomorrow.setDate(tomorrow.getDate() + 1);
                const tomorrowStr = tomorrow.toISOString().split('T')[0];
                
                endDateInput.min = tomorrowStr;
                endDateInput.value = tomorrowStr;
                
                // Обработчик изменения даты начала
                startDateInput.addEventListener('change', function() {
                    const startDate = new Date(this.value);
                    const minEndDate = new Date(startDate);
                    minEndDate.setDate(minEndDate.getDate() + 1);
                    
                    endDateInput.min = minEndDate.toISOString().split('T')[0];
                    
                    if (new Date(endDateInput.value) < minEndDate) {
                        endDateInput.value = minEndDate.toISOString().split('T')[0];
                    }
                });
                
                // Добавляем обработчик отправки формы для отладки
                document.querySelector('form').addEventListener('submit', function(e) {
                    console.log('Форма отправляется...');
                    const carId = document.querySelector('[asp-for="Booking.CarId"]').value;
                    const pickupLocationId = document.querySelector('[asp-for="Booking.PickupLocationId"]').value;
                    const returnLocationId = document.querySelector('[asp-for="Booking.ReturnLocationId"]').value;
                    const startDate = document.querySelector('[asp-for="StartDate"]').value;
                    const endDate = document.querySelector('[asp-for="EndDate"]').value;
                    
                    console.log('Данные формы:', {
                        carId, pickupLocationId, returnLocationId, startDate, endDate
                    });
                });
            }
        });
    </script>
}