@page
@model RentalAuto.Pages.Clients.EditModel
@{
    ViewData["Title"] = "Редактировать клиента";
}

<h1>Редактировать клиента</h1>
<hr />
<div class="row">
    <div class="col-md-8">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Client.ClientId" />
            
            <div class="row mb-3">
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="Client.Surname" class="control-label"></label>
                        <input asp-for="Client.Surname" class="form-control" />
                        <span asp-validation-for="Client.Surname" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="Client.Firstname" class="control-label"></label>
                        <input asp-for="Client.Firstname" class="form-control" />
                        <span asp-validation-for="Client.Firstname" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="Client.Patronymic" class="control-label"></label>
                        <input asp-for="Client.Patronymic" class="form-control" />
                        <span asp-validation-for="Client.Patronymic" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="Client.DateOfBirth" class="control-label"></label>
                        <input asp-for="Client.DateOfBirth" class="form-control" type="date" />
                        <span asp-validation-for="Client.DateOfBirth" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="Client.Phone" class="control-label"></label>
                        <input asp-for="Client.Phone" class="form-control" placeholder="+79001234567" />
                        <span asp-validation-for="Client.Phone" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="Client.Email" class="control-label"></label>
                        <input asp-for="Client.Email" class="form-control" type="email" />
                        <span asp-validation-for="Client.Email" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="Client.PassportNumber" class="control-label"></label>
                        <input asp-for="Client.PassportNumber" class="form-control" placeholder="1234567890" />
                        <span asp-validation-for="Client.PassportNumber" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="Client.DriverLicenseNumber" class="control-label"></label>
                        <input asp-for="Client.DriverLicenseNumber" class="form-control" placeholder="0987654321" />
                        <span asp-validation-for="Client.DriverLicenseNumber" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="form-group mt-3">
                <input type="submit" value="Сохранить" class="btn btn-primary" />
                <a asp-page="./Index" class="btn btn-secondary">Отмена</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}