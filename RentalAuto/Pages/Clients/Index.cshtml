@page "{sortOrder?}/{searchString?}/{pageIndex?}"
@model RentalAuto.Pages.Clients.IndexModel
@{
    ViewData["Title"] = "Список клиентов";
}

<h1>Список клиентов</h1>

<p>
    @if (User.IsInRole("rental_admin"))
    {
        <a asp-page="Create" class="btn btn-primary">Добавить нового клиента</a>
    }
</p>

@* Форма поиска *@
<form asp-page="./Index" method="get">
    <div class="form-actions no-color">
        <p>
            Найти по ФИО, email или паспорту:
            <input type="text" name="SearchString" value="@Model.CurrentFilter" class="form-control d-inline" style="width: 200px;" />
            <input type="submit" value="Поиск" class="btn btn-sm btn-outline-secondary" /> |
            <a asp-page="./Index">Показать все</a>
        </p>
    </div>
</form>

<table class="table table-hover">
    <thead class="table-light">
        <tr>
            <th>
                <a asp-page="./Index" 
                   asp-route-sortOrder="@(Model.CurrentSort == "surname_asc" ? "surname_desc" : "surname_asc")"
                   asp-route-searchString="@Model.CurrentFilter">
                    Фамилия @if (Model.CurrentSort == "surname_asc") { <span>▲</span> } else if (Model.CurrentSort == "surname_desc") { <span>▼</span> }
                </a>
            </th>
            <th>
                <a asp-page="./Index" 
                   asp-route-sortOrder="@(Model.CurrentSort == "name_asc" ? "name_desc" : "name_asc")"
                   asp-route-searchString="@Model.CurrentFilter">
                    Имя @if (Model.CurrentSort == "name_asc") { <span>▲</span> } else if (Model.CurrentSort == "name_desc") { <span>▼</span> }
                </a>
            </th>
            <th>
                <a asp-page="./Index" 
                   asp-route-sortOrder="@(Model.CurrentSort == "date_asc" ? "date_desc" : "date_asc")"
                   asp-route-searchString="@Model.CurrentFilter">
                    Дата рождения @if (Model.CurrentSort == "date_asc") { <span>▲</span> } else if (Model.CurrentSort == "date_desc") { <span>▼</span> }
                </a>
            </th>
            <th>
                <a asp-page="./Index" 
                   asp-route-sortOrder="@(Model.CurrentSort == "email_asc" ? "email_desc" : "email_asc")"
                   asp-route-searchString="@Model.CurrentFilter">
                    Email @if (Model.CurrentSort == "email_asc") { <span>▲</span> } else if (Model.CurrentSort == "email_desc") { <span>▼</span> }
                </a>
            </th>
            <th>Действия</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Client) {
        <tr>
            <td>@Html.DisplayFor(modelItem => item.Surname)</td>
            <td>@Html.DisplayFor(modelItem => item.Firstname)</td>
            <td>@Html.DisplayFor(modelItem => item.DateOfBirth)</td>
            <td>@Html.DisplayFor(modelItem => item.Email)</td>
            <td>
                <a asp-page="./Details" asp-route-id="@item.ClientId" class="btn btn-sm btn-info">Подробнее</a>
                @if (User.IsInRole("rental_client"))
                {
                    // Если текущий пользователь - клиент и это его запись
                    if (Model.IsClientRole)
                    {
                        <a asp-page="./Edit" asp-route-id="@item.ClientId" class="btn btn-sm btn-warning">Редактировать</a>
                    }
                }
                else if (User.IsInRole("rental_admin"))
                {
                    <a asp-page="./Edit" asp-route-id="@item.ClientId" class="btn btn-sm btn-warning">Редактировать</a>
                    <a asp-page="./Delete" asp-route-id="@item.ClientId" class="btn btn-sm btn-danger">Удалить</a>
                }
            </td>
        </tr>
}
    </tbody>
</table>

@* Пагинация *@
<nav>
    <ul class="pagination">
        <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
            <a class="page-link" asp-page="./Index" 
               asp-route-sortOrder="@Model.CurrentSort"
               asp-route-searchString="@Model.CurrentFilter"
               asp-route-pageIndex="@(Model.CurrentPage - 1)">Предыдущая</a>
        </li>
        
        @for (int i = 1; i <= Model.TotalPages; i++)
        {
            <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                <a class="page-link" asp-page="./Index"
                   asp-route-sortOrder="@Model.CurrentSort"
                   asp-route-searchString="@Model.CurrentFilter"
                   asp-route-pageIndex="@i">@i</a>
            </li>
        }
        
        <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
            <a class="page-link" asp-page="./Index" 
               asp-route-sortOrder="@Model.CurrentSort"
               asp-route-searchString="@Model.CurrentFilter"
               asp-route-pageIndex="@(Model.CurrentPage + 1)">Следующая</a>
        </li>
    </ul>
</nav>