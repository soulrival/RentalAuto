@page
@model RentalAuto.Pages.Bookings.CreateModel
@{
    ViewData["Title"] = "Создать бронирование";
}

<h1>Создать новое бронирование</h1>
<hr />
<div class="row">
    <div class="col-md-8">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            
            <div class="row mb-3">
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="control-label">Автомобиль</label>
                        <select asp-for="Booking.CarId" class="form-control" asp-items="Model.CarList">
                            <option value="">-- Выберите автомобиль --</option>
                        </select>
                        <span asp-validation-for="Booking.CarId" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="control-label">Локация получения</label>
                        <select asp-for="Booking.PickupLocationId" class="form-control" asp-items="Model.LocationList">
                            <option value="">-- Выберите локацию --</option>
                        </select>
                        <span asp-validation-for="Booking.PickupLocationId" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="control-label">Локация возврата</label>
                        <select asp-for="Booking.ReturnLocationId" class="form-control" asp-items="Model.LocationList">
                            <option value="">-- Выберите локацию --</option>
                        </select>
                        <span asp-validation-for="Booking.ReturnLocationId" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="StartDate" class="control-label"></label>
                        <input asp-for="StartDate" class="form-control" type="date" min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                        <span asp-validation-for="StartDate" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="EndDate" class="control-label"></label>
                        <input asp-for="EndDate" class="form-control" type="date" min="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")" />
                        <span asp-validation-for="EndDate" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="form-group mb-3">
                <label class="control-label">Дополнительные услуги</label>
                <div class="row">
                    @foreach (var service in Model.ServiceList)
                    {
                        <div class="col-md-4">
                            <div class="form-check">
                                <input type="checkbox" 
                                       name="SelectedServiceIds" 
                                       value="@service.Value" 
                                       class="form-check-input" 
                                       id="service_@service.Value" />
                                <label class="form-check-label" for="service_@service.Value">
                                    @service.Text
                                </label>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <div class="form-group mt-3">
                <input type="submit" value="Создать бронирование" class="btn btn-primary" />
                <a asp-page="./Index" class="btn btn-secondary">Отмена</a>
            </div>
        </form>
    </div>
    <div class="col-md-4">
        <div class="card border-info">
            <div class="card-header bg-info text-white">
                <h5 class="card-title mb-0">Информация о бронировании</h5>
            </div>
            <div class="card-body">
                <p class="card-text">
                    <strong>Важная информация:</strong>
                </p>
                <ul class="card-text">
                    <li>Автомобиль будет автоматически помечен как недоступный после бронирования</li>
                    <li>Стоимость будет рассчитана автоматически с учетом всех услуг</li>
                    <li>Вы можете просмотреть и отменить бронирование в личном кабинете</li>
                    <li>Договор будет сгенерирован автоматически при подтверждении</li>
                </ul>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    
    <script>
        // JavaScript для валидации дат
        document.addEventListener('DOMContentLoaded', function() {
            const startDateInput = document.querySelector('[asp-for="StartDate"]');
            const endDateInput = document.querySelector('[asp-for="EndDate"]');
            
            if (startDateInput && endDateInput) {
                // Установка минимальной даты для начала
                const today = new Date();
                today.setHours(0, 0, 0, 0);
                startDateInput.min = today.toISOString().split('T')[0];
                
                // Установка минимальной даты для окончания
                const tomorrow = new Date(today);
                tomorrow.setDate(tomorrow.getDate() + 1);
                endDateInput.min = tomorrow.toISOString().split('T')[0];
                
                // Валидация: дата окончания должна быть позже даты начала
                startDateInput.addEventListener('change', function() {
                    const startDate = new Date(this.value);
                    const minEndDate = new Date(startDate);
                    minEndDate.setDate(minEndDate.getDate() + 1);
                    
                    endDateInput.min = minEndDate.toISOString().split('T')[0];
                    
                    if (new Date(endDateInput.value) < minEndDate) {
                        endDateInput.value = minEndDate.toISOString().split('T')[0];
                    }
                });
            }
        });
    </script>
}