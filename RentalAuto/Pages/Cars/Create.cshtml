@page
@model RentalAuto.Pages.Cars.CreateModel
@{
    ViewData["Title"] = "Добавить автомобиль";
}

<h1>Добавить новый автомобиль</h1>
<hr />
<div class="row">
    <div class="col-md-8">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            
            <div class="row mb-3">
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="Car.Vin" class="control-label"></label>
                        <input asp-for="Car.Vin" class="form-control" />
                        <span asp-validation-for="Car.Vin" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="Car.RegistrationNumber" class="control-label"></label>
                        <input asp-for="Car.RegistrationNumber" class="form-control" />
                        <span asp-validation-for="Car.RegistrationNumber" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="Car.Brand" class="control-label"></label>
                        <input asp-for="Car.Brand" class="form-control" />
                        <span asp-validation-for="Car.Brand" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="Car.ModelName" class="control-label"></label>
                        <input asp-for="Car.ModelName" class="form-control" />
                        <span asp-validation-for="Car.ModelName" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-4">
                    <div class="form-group">
                        <label asp-for="Car.Class" class="control-label"></label>
                        <select asp-for="Car.Class" class="form-control" asp-items="Model.ClassList"></select>
                        <span asp-validation-for="Car.Class" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label asp-for="Car.Year" class="control-label"></label>
                        <input asp-for="Car.Year" class="form-control" type="number" min="1980" max="@DateTime.Now.Year" />
                        <span asp-validation-for="Car.Year" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label asp-for="Car.Engine" class="control-label"></label>
                        <input asp-for="Car.Engine" class="form-control" />
                        <span asp-validation-for="Car.Engine" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-4">
                    <div class="form-group">
                        <label asp-for="Car.Transmission" class="control-label"></label>
                        <select asp-for="Car.Transmission" class="form-control" asp-items="Model.TransmissionList"></select>
                        <span asp-validation-for="Car.Transmission" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label asp-for="Car.Seats" class="control-label"></label>
                        <input asp-for="Car.Seats" class="form-control" type="number" min="2" max="9" />
                        <span asp-validation-for="Car.Seats" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label asp-for="Car.Mileage" class="control-label"></label>
                        <input asp-for="Car.Mileage" class="form-control" type="number" min="0" />
                        <span asp-validation-for="Car.Mileage" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-4">
                    <div class="form-group">
                        <label asp-for="Car.FuelType" class="control-label"></label>
                        <select asp-for="Car.FuelType" class="form-control" asp-items="Model.FuelTypeList"></select>
                        <span asp-validation-for="Car.FuelType" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label asp-for="Car.Status" class="control-label"></label>
                        <select asp-for="Car.Status" class="form-control" asp-items="Model.StatusList"></select>
                        <span asp-validation-for="Car.Status" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label asp-for="Car.PricePerDay" class="control-label"></label>
                        <input asp-for="Car.PricePerDay" class="form-control" type="number" step="0.01" min="0.01" />
                        <span asp-validation-for="Car.PricePerDay" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="form-group">
                <label asp-for="Car.Description" class="control-label"></label>
                <textarea asp-for="Car.Description" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Car.Description" class="text-danger"></span>
            </div>

            <div class="form-group mt-3">
                <input type="submit" value="Добавить" class="btn btn-primary" />
                <a asp-page="Index" class="btn btn-secondary">Отмена</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
